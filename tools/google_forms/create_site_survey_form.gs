/**
 * 【実態把握】拠点別 運営状況アンケート(9月度) 自動生成スクリプト
 *
 * 使い方:
 *   1. https://script.google.com/ を開き「新しいプロジェクト」を作成
 *   2. 本ファイルの内容をすべて貼り付けて保存
 *   3. SITE_NAMES を自社の40拠点名に差し替える
 *   4. 関数 createSurveyForm を選択して「実行」(初回は権限承認が必要)
 *   5. 実行ログに出力される編集URL / 回答URL を開く
 *
 * 設計上の約束:
 *   - 均等目盛(Scale)は全て「5 = 良い状態」で統一。単純平均がそのまま
 *     「高いほど良い」で解釈できる。
 *   - 問5(看護師)は配置義務のない拠点があるため必須を外し、
 *     「配置対象外の場合は空欄のままで可」と説明文に明記。
 *   - 問13(上限2つ) / 問34(上限3つ)はチェックボックスの選択数制限を設定。
 */

// ---- 拠点名(40拠点)。実際の拠点名に差し替えてください ------------------
var SITE_NAMES = [
  '拠点01', '拠点02', '拠点03', '拠点04', '拠点05',
  '拠点06', '拠点07', '拠点08', '拠点09', '拠点10',
  '拠点11', '拠点12', '拠点13', '拠点14', '拠点15',
  '拠点16', '拠点17', '拠点18', '拠点19', '拠点20',
  '拠点21', '拠点22', '拠点23', '拠点24', '拠点25',
  '拠点26', '拠点27', '拠点28', '拠点29', '拠点30',
  '拠点31', '拠点32', '拠点33', '拠点34', '拠点35',
  '拠点36', '拠点37', '拠点38', '拠点39', '拠点40'
];

var FORM_TITLE = '【実態把握】拠点別 運営状況アンケート(9月度)';
var FORM_DESCRIPTION =
  '本アンケートは、各拠点のKPI未達要因を定量的に把握するためのものです。' +
  '評価目的ではありませんので、実態に即してご回答ください。' +
  '担当拠点が複数ある場合は、拠点ごとに1回ずつご回答ください。' +
  '(所要時間の目安:15分程度)';

function createSurveyForm() {
  var form = FormApp.create(FORM_TITLE);
  form.setTitle(FORM_TITLE)
      .setDescription(FORM_DESCRIPTION)
      .setCollectEmail(true)
      .setProgressBar(true)
      .setAllowResponseEdits(true)
      .setLimitOneResponsePerUser(false);

  // ===== セクション1:基本情報 =========================================
  section(form, 'セクション1:基本情報', '回答者と対象拠点を特定するための項目です。');

  form.addTextItem()
      .setTitle('1. 回答者名(AM名)')
      .setRequired(true);

  form.addListItem()
      .setTitle('2. 対象拠点名')
      .setHelpText('担当拠点が複数ある場合は、拠点ごとに1回ずつご回答ください。')
      .setChoiceValues(SITE_NAMES)
      .setRequired(true);

  form.addDateItem()
      .setTitle('3. 回答日')
      .setRequired(true);

  // ===== セクション2:人員体制 =========================================
  section(form, 'セクション2:人員体制', '現時点の配置状況について、実態に即してご回答ください。');

  scale(form, '4. 支援員の人員配置基準充足度', '大幅不足', '十分', true);

  scale(form, '5. 看護師の人員配置基準充足度',
        '大幅不足', '十分', false,
        '配置対象外の拠点は、空欄のままで構いません。');

  scale(form, '6. 送迎要員の人員配置基準充足度', '大幅不足', '十分', true);

  radio(form, '7. 直近1ヶ月の欠員人数',
        ['0人', '1人', '2人', '3人以上']);

  radio(form, '8. 欠員の補充見込み時期',
        ['未定', '1ヶ月以内', '1〜3ヶ月', '3ヶ月以上', '該当なし(欠員なし)']);

  // ===== セクション3:採用・定着状況 ===================================
  section(form, 'セクション3:採用・定着状況', '直近3ヶ月の採用活動の実績についてご回答ください。');

  radio(form, '9. 直近3ヶ月の採用応募数',
        ['0件', '1〜2件', '3〜5件', '6件以上']);

  radio(form, '10. 直近3ヶ月の採用面接実施数',
        ['0件', '1〜2件', '3〜5件', '6件以上']);

  radio(form, '11. 直近3ヶ月の新規採用人数',
        ['0人', '1人', '2人', '3人以上']);

  radio(form, '12. 直近3ヶ月の新入職員の離職人数',
        ['0人', '1人', '2人', '3人以上']);

  checkboxLimited(form, '13. 主な応募経路(上位2つまで)',
        ['求人媒体', 'ハローワーク', '人材紹介会社', '自社HP',
         '職員紹介', '学校・養成校', 'その他'],
        2);

  scale(form, '14. 採用充足度に対する実感', '全く足りていない', '十分足りている', true);

  // ===== セクション4:サービス管理責任者の機能 =========================
  section(form, 'セクション4:サービス管理責任者の機能',
          'サービス管理責任者(サビ管)の稼働実態についてご回答ください。');

  radio(form, '15. サビ管の勤務形態', ['専従', '兼務']);

  scale(form, '16. 個別支援計画モニタリングの期限遵守度', '大幅遅延', '期限通り', true);

  scale(form, '17. サビ管の見学・体験対応への同席頻度', 'ほとんどない', '常に同席', true);

  radio(form, '18. 個別支援計画書作成後、相談支援専門員への送付実施率',
        ['0〜25%', '26〜50%', '51〜75%', '76〜99%', '100%']);

  scale(form, '19. 個別支援計画の内容が利用者ごとに個別性を反映できていると感じるか',
        '画一的', '明確に個別化されている', true);

  // ===== セクション5:職員間の人間関係 =================================
  section(form, 'セクション5:職員間の人間関係',
          '本セクションは職員個人の評価を目的とするものではありません。実態に即してご回答ください。');

  scale(form, '20. 拠点内の職員間の人間関係の状態', '深刻な問題あり', '良好', true);

  radio(form, '21. 直近3ヶ月の離職者数', ['0人', '1人', '2人', '3人以上']);

  scale(form, '22. 職員から人間関係に関する相談・訴えを受けた頻度',
        '頻繁にある', '全くない', true);

  // ===== セクション6:法令順守・コンプライアンス =======================
  section(form, 'セクション6:法令順守・コンプライアンス',
          '運営基準上の必須事項に関する項目です。');

  scale(form, '23. 虐待防止委員会・身体拘束適正化委員会の定期開催状況',
        '未開催', '計画通り開催', true);

  scale(form, '24. サービス提供記録・実績記録の記入遅延頻度',
        '常態化している', '遅延なし', true);

  radio(form, '25. 直近半年の行政からの指摘・改善要求の有無', ['あり', 'なし']);

  // ===== セクション7:送迎・受け入れキャパシティ =======================
  section(form, 'セクション7:送迎・受け入れキャパシティ',
          '受け入れ余力のボトルネックを把握するための項目です。');

  scale(form, '26. 送迎車両・ルートの余力度', '超過している', '十分余力あり', true);

  scale(form, '27. 契約は取れても受け入れられない事象の発生頻度',
        '頻繁にある', '全くない', true);

  // ===== セクション8:競合・地域環境 ===================================
  section(form, 'セクション8:競合・地域環境', '拠点周辺の外部環境についてご回答ください。');

  radio(form, '28. 直近1年の近隣競合新規開設の有無', ['あり', 'なし']);

  scale(form, '29. 地域の対象者数の傾向', '大きく減少', '増加傾向', true);

  // ===== セクション9:紹介元との関係 ===================================
  section(form, 'セクション9:紹介元との関係', '紹介元(相談支援専門員等)との関係性についてご回答ください。');

  radio(form, '30. 相談支援専門員等との接点頻度',
        ['週1回以上',
         '月1〜3回程度',
         '2〜3ヶ月に1回程度',
         '半年に1回程度',
         'ほとんど接点がない'],
        '訪問・電話・同行等を含む、実務上の接点の頻度でご回答ください。');

  radio(form, '31. 直近3ヶ月の紹介元経由の紹介件数',
        ['0件', '1〜2件', '3〜5件', '6件以上']);

  radio(form, '32. 紹介元との関係悪化事案の有無(直近1年)', ['あり', 'なし']);

  // ===== セクション10:営業活動の実態 ==================================
  section(form, 'セクション10:営業活動の実態', '集客導線の実態を把握するための項目です。');

  scale(form, '33. 営業活動にかけられている時間の十分度', '全く足りない', '十分', true);

  checkboxLimited(form, '34. 主な営業アプローチ先(多い順に上位2〜3つ)',
        ['特別支援学校',
         '相談支援専門員・基幹相談支援センター',
         '他施設からの紹介・移行',
         '在宅・保護者からの直接問い合わせ',
         '自治体窓口',
         '一般問い合わせ(HP・電話等)',
         '職員・利用者家族からの紹介',
         'その他'],
        3);

  scale(form, '35. 営業件数のうち対象要件(区分等)を事前確認しているアプローチの割合',
        'ほぼ確認していない', '全件確認している', true);

  radio(form, '36. 見学・体験から契約に至らない主な理由',
        ['本人・家族の検討長期化',
         '区分・医療対応等の条件不一致',
         '他施設と比較検討中',
         '送迎対応不可',
         '特に理由なく離脱'],
        '最も多いものを1つ選択してください。');

  // ===== セクション11:プログラム・サービス内容 ========================
  section(form, 'セクション11:プログラム・サービス内容',
          '自拠点のサービス内容に対するご自身の実感をご回答ください。');

  scale(form, '37. 自施設の過ごし方・支援の仕方・プログラムに魅力を感じるか',
        '魅力を感じない', '強く魅力を感じる', true);

  scale(form, '38. 他施設と比較した自拠点の競争力の実感', '弱い', '強い', true);

  // ===== セクション12:総合 ============================================
  section(form, 'セクション12:総合', '最後に、総合的な認識についてご回答ください。');

  radio(form, '39. 現在、拠点運営において最も懸念していることを1つ選択',
        ['人員不足', '人間関係', '営業・集客', '送迎キャパ',
         '競合', '法令順守', 'その他']);

  form.addParagraphTextItem()
      .setTitle('40. (任意)39で選んだ内容について補足があれば')
      .setRequired(false);

  Logger.log('編集URL: ' + form.getEditUrl());
  Logger.log('回答URL: ' + form.getPublishedUrl());
  return form.getEditUrl();
}

// ---- ヘルパー関数 --------------------------------------------------------

/** セクション(ページ区切り)を追加 */
function section(form, title, description) {
  var page = form.addPageBreakItem().setTitle(title);
  if (description) { page.setHelpText(description); }
  return page;
}

/** 均等目盛(1〜5、5=良い状態で統一) */
function scale(form, title, lowLabel, highLabel, required, helpText) {
  var item = form.addScaleItem()
      .setTitle(title)
      .setBounds(1, 5)
      .setLabels(lowLabel, highLabel)
      .setRequired(required === true);
  if (helpText) { item.setHelpText(helpText); }
  return item;
}

/** ラジオボタン(単一選択) */
function radio(form, title, choices, helpText) {
  var item = form.addMultipleChoiceItem()
      .setTitle(title)
      .setChoiceValues(choices)
      .setRequired(true);
  if (helpText) { item.setHelpText(helpText); }
  return item;
}

/** チェックボックス(選択数の上限つき) */
function checkboxLimited(form, title, choices, maxSelect) {
  var validation = FormApp.createCheckboxValidation()
      .setHelpText(maxSelect + 'つまで選択してください。')
      .requireSelectAtMost(maxSelect)
      .build();
  return form.addCheckboxItem()
      .setTitle(title)
      .setHelpText('最大' + maxSelect + 'つまで選択できます。')
      .setChoiceValues(choices)
      .setRequired(true)
      .setValidation(validation);
}
