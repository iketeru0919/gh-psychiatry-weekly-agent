function createSurveyForm() {
  var form = FormApp.create(TITLE);
  form.setTitle(TITLE).setDescription(DESC)
      .setCollectEmail(true).setProgressBar(true).setAllowResponseEdits(true);

  for (var i = 0; i < ITEMS.length; i++) {
    var type = ITEMS[i][0];
    var title = ITEMS[i][1];
    var opts = ITEMS[i][2];
    var cfg = ITEMS[i][3] || {};
    var required = (cfg.req !== false);
    var item;

    if (type === 'sec') {
      item = form.addPageBreakItem().setTitle(title);
      if (opts) { item.setHelpText(opts); }
      continue;
    }

    if (type === 'text') {
      item = form.addTextItem();
    } else if (type === 'paragraph') {
      item = form.addParagraphTextItem();
    } else if (type === 'date') {
      item = form.addDateItem();
    } else if (type === 'scale') {
      item = form.addScaleItem().setBounds(1, 5).setLabels(opts[0], opts[1]);
    } else if (type === 'radio') {
      item = form.addMultipleChoiceItem().setChoiceValues(opts);
    } else if (type === 'check') {
      item = form.addCheckboxItem().setChoiceValues(opts).setValidation(
        FormApp.createCheckboxValidation()
               .setHelpText(cfg.max + 'つまで選択してください。')
               .requireSelectAtMost(cfg.max).build());
    } else {
      throw new Error('未知の設問タイプ: ' + type);
    }

    item.setTitle(title).setRequired(required);
    var help = cfg.help || (type === 'check' ? '最大' + cfg.max + 'つまで選択できます。' : '');
    if (help) { item.setHelpText(help); }
  }

  Logger.log('編集URL: ' + form.getEditUrl());
  Logger.log('回答URL: ' + form.getPublishedUrl());
  return form.getEditUrl();
}
