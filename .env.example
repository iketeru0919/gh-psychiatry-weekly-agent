# Required: OpenAI API key used for scoring and Japanese report generation.
OPENAI_API_KEY=sk-your-key

# Required by NCBI E-utilities policy. Use a real contact email.
NCBI_EMAIL=you@example.com

# Optional settings
OPENAI_MODEL=gpt-4.1-mini
NCBI_TOOL=psychiatry-weekly-gh-agent
REPORT_OUTPUT_DIR=reports
PUBMED_RETMAX=100
MIN_CANDIDATES_BEFORE_EXPAND=30
